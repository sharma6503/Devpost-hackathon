# =============================================================================
# Agent Guardian — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (it is already in .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# Google Cloud / Vertex AI (REQUIRED)
# -----------------------------------------------------------------------------

# Use Vertex AI / Enterprise backend (set to FALSE to use AI Studio / GOOGLE_API_KEY)
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your GCP project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# *** CRITICAL for Gemini 3+ models: must be 'global' ***
# Gemini 3.x preview models (gemini-3-flash-preview, gemini-3.1-pro-preview, etc.)
# are ONLY available via the global endpoint. Using us-central1 will fail.
GOOGLE_CLOUD_LOCATION=global

# AI Studio API key (only required when GOOGLE_GENAI_USE_ENTERPRISE=FALSE)
# GOOGLE_API_KEY=your-google-ai-studio-api-key

# -----------------------------------------------------------------------------
# Google Cloud Skill Registry (OPTIONAL — load specific skills during review)
# -----------------------------------------------------------------------------
# Comma-separated list of skill names to fetch from the GCP Skills Registry.
# Only the skills configured here will be fetched and utilized during the review.
# Example: GCP_SKILLS=governance-audit,implementation-standards,pilot-to-prod-checklist
# GCP_SKILLS=governance-audit,implementation-standards


# -----------------------------------------------------------------------------
# GitHub Integration (REQUIRED for GitHub URL reviews & Remediation)
# -----------------------------------------------------------------------------

# Personal Access Token with repo read/write and PR permissions
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Target repository for remediation fixes (e.g. 'owner/repo')
# MANDATORY if reviewing local files and you want the agent to push fixes.
GITHUB_REMEDIATION_REPO=owner/repo

# Default base branch for PRs (default: main)
GITHUB_BASE_BRANCH=main


# -----------------------------------------------------------------------------
# Atlassian / Confluence Integration (REQUIRED for live rule injection)
# -----------------------------------------------------------------------------

# Atlassian Cloud URL (Required for persistent API Token auth)
ATLASSIAN_URL=https://yourorg.atlassian.net

# Your Atlassian account email address (Preferred)
ATLASSIAN_USERNAME=your.email@company.com
# Fallback: BITBUCKET_USERNAME=your.email@company.com

# Atlassian API token (NOT your password) - Recommended for persistent auth (bypasses 8-hour expiry)
ATLASSIAN_API_TOKEN=your_atlassian_api_token
# Fallback: BITBUCKET_APP_PASSWORD=your_atlassian_api_token

# Bitbucket HTTP access token (Bearer) — preferred over username+app_password for repo ingestion.
# Generate at: Bitbucket → Personal settings → HTTP access tokens
# BITBUCKET_TOKEN=your_bitbucket_http_access_token

# Comma-separated list of Confluence page URLs containing your standards
CONFLUENCE_PAGE_URLS=https://yourorg.atlassian.net/wiki/spaces/ENG/pages/12345,https://yourorg.atlassian.net/wiki/spaces/ENG/pages/67890


# -----------------------------------------------------------------------------
# Model Fleet Overrides (OPTIONAL — defaults shown below)
# -----------------------------------------------------------------------------

# ROOT_MODEL=gemini-3.1-flash-lite-preview
# GOVERNANCE_MODEL=gemini-3-flash-preview   # set to gemini-3.1-pro-preview for deep rule interpretation (~10x cost)
# ADK_EXPERT_MODEL=gemini-3-flash-preview
# HTML_MODEL=gemini-3-flash-preview         # report assembly needs full Flash tier (lite truncates large reports)
# FOLLOWUP_MODEL=gemini-3-flash-preview     # post-review follow-up Q&A (reasoning + read-only tool use)

# Per-task sampling temperatures (OPTIONAL — defaults shown)
# EVALUATION_TEMPERATURE=0.2   # deterministic scoring
# METRICS_TEMPERATURE=0.2      # deterministic structured extraction
# SYNTHESIS_TEMPERATURE=0.7    # prose synthesis
# HTML_TEMPERATURE=0.3         # precise templated HTML

# Skip the matplotlib metrics chart for lightweight reviews (OPTIONAL)
# DISABLE_METRICS_CHART=true

# Context caching tuning (OPTIONAL — defaults shown)
# CONTEXT_CACHE_MIN_TOKENS=4096
# CONTEXT_CACHE_TTL_SECONDS=3600
# CONTEXT_CACHE_INTERVALS=10


# -----------------------------------------------------------------------------
# Evaluation Quality Gate (Upgrade 3)
# -----------------------------------------------------------------------------

# Minimum score (0-10) a review must achieve to pass without retry
EVAL_PASS_THRESHOLD=6

# Maximum number of self-improvement iterations (default 2: evaluate, allow one
# revision round, then exit; set to 1 for a single pass)
EVAL_MAX_ITERATIONS=2


# -----------------------------------------------------------------------------
# Quota / 429 mitigation (OPTIONAL)
# -----------------------------------------------------------------------------

# Gemini API retry attempts per model call (exponential backoff 2s→60s w/ jitter)
# MAX_RETRIES=5

# Fixed delay (seconds) before EVERY expert agent starts — staggers the 5-way
# parallel fan-out on low-RPM preview model quotas. 0 = adaptive only (pacing
# kicks in automatically after the first 429 is observed).
# PACING_FORCE_DELAY_SEC=0

# Base for the adaptive inter-agent delay after a 429 (delay = base * 2^retries)
# PACING_DELAY_SEC=12


# -----------------------------------------------------------------------------
# API service (api/main.py — serves the ADK API the frontend proxies to)
# -----------------------------------------------------------------------------

# Comma-separated CORS origins for the FastAPI service (default: localhost:3000)
# API_ALLOW_ORIGINS=http://localhost:3000

# Session persistence configuration:
#   SESSION_SERVICE_TYPE=vertexai                                    # Use Vertex AI Session Service
#   SESSION_SERVICE_URI=agentengine://<reasoning-engine-id>          # URI scheme for Vertex AI Session Service
#   SESSION_LOCATION=us-central1                                     # Regional location for ReasoningEngine (when GOOGLE_CLOUD_LOCATION=global)
#   SESSION_SERVICE_URI=sqlite:///./runs/sessions.db                 # local / single instance
#   SESSION_SERVICE_URI=postgresql+psycopg://USER:PW@HOST:5432/DB    # multi-instance / Cloud Run (Cloud SQL)
# SESSION_SERVICE_TYPE=vertexai
# SESSION_SERVICE_URI=agentengine://projects/your-gcp-project-id/locations/us-central1/reasoningEngines/<reasoning-engine-id>
# SESSION_LOCATION=us-central1

# Artifact persistence (HTML report artifacts). Same idea — unset = in-memory.
#   ARTIFACT_SERVICE_URI=gs://your-bucket-name
# ARTIFACT_SERVICE_URI=

# Login accounts (POST /auth/login, agent_guardian/auth.py). BigQuery table of
# admin-provisioned users — see scripts/seed_bq_user.py to add one. Defaults
# shown match imgcp-51c5a39739fbedcd.agent_gaurdian.users.
# BQ_PROJECT=imgcp-51c5a39739fbedcd
# BQ_DATASET=agent_gaurdian
# BQ_USERS_TABLE=users

# -----------------------------------------------------------------------------
# Troubleshooting
# -----------------------------------------------------------------------------

# Fix for charmap encoding crashes in Windows console
PYTHONIOENCODING=utf-8
